# Copy to /etc/whaletale/agent.env. Contains no secrets itself - the pairing
# token and RTSP credentials live in /etc/whaletale/site.json (mode 0600).
EDGE_SQLITE_PATH=/var/lib/whaletale/edge_local.db
EDGE_HF_CACHE=/var/lib/whaletale/hf_cache
EDGE_TARGET_FPS=4
EDGE_INFERENCE_DEVICE=cuda
EDGE_MODEL_ID=PekingU/rtdetr_r50vd
EDGE_MIN_DWELL_SECONDS=3
EDGE_BUCKET_SECONDS=900
WHALETALE_CLOUD_URL=https://api.whaletale.tech
WHALETALE_SITE_SECRET=change-me-per-site   # derives the camera-credential key (onboarding)
