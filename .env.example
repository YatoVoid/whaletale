# Copy to .env and fill in. Never commit .env. Never put real values here.

# --- Edge agent ---
WHALETALE_SITE_ID=
WHALETALE_SITE_SECRET=            # used to derive the camera-credential encryption key
WHALETALE_CLOUD_URL=https://api.whaletale.tech
WHALETALE_PAIRING_TOKEN=         # one-time token to register this edge box with the cloud
EDGE_SQLITE_PATH=./edge_local.db
EDGE_TARGET_FPS=4
EDGE_INFERENCE_DEVICE=cpu        # cpu | cuda
EDGE_DETECTOR=rtdetr             # rtdetr | yolox
EDGE_MODEL_ID=PekingU/rtdetr_r50vd
EDGE_HF_CACHE=./.hf_cache
EDGE_SCORE_THRESHOLD=0.5         # detector confidence floor, 0..1
EDGE_MIN_DWELL_SECONDS=3        # spec 6.4: seconds inside a zone before it counts as an entry
EDGE_EXIT_MARGIN_FRAC=0.02      # spec 8.2: exit hysteresis, fraction of frame size
EDGE_CATCHMENT_FRAC=0.08        # spec 6.4: passerby catchment, polygon dilation fraction
EDGE_BUCKET_SECONDS=900         # spec 6.5: rollup bucket width in stream-time seconds

# --- Cloud API (from M5) ---
DATABASE_URL=postgresql+psycopg://whaletale:whaletale@localhost:5432/whaletale
REDIS_URL=redis://localhost:6379/0
API_SECRET_KEY=
SENTRY_DSN=

# --- Auth (from M6) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Stripe (from M9) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Web (from M6) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
