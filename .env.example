# Copy to .env and fill in. Never commit .env. Never put real values here.

# --- Edge agent ---
WHALETALE_SITE_ID=
WHALETALE_SITE_SECRET=            # used to derive the camera-credential encryption key
WHALETALE_CLOUD_URL=https://api.whaletale.tech
WHALETALE_PAIRING_TOKEN=         # one-time token to register this edge box with the cloud
EDGE_SQLITE_PATH=./edge_local.db
EDGE_TARGET_FPS=4
EDGE_INFERENCE_DEVICE=cpu        # cpu | cuda
EDGE_DETECTOR=rtdetr             # rtdetr | yolox
EDGE_MODEL_ID=PekingU/rtdetr_r50vd
EDGE_HF_CACHE=./.hf_cache
EDGE_SCORE_THRESHOLD=0.5         # detector confidence floor, 0..1
EDGE_MIN_DWELL_SECONDS=3        # spec 6.4: seconds inside a zone before it counts as an entry
EDGE_EXIT_MARGIN_FRAC=0.02      # spec 8.2: exit hysteresis, fraction of frame size
EDGE_CATCHMENT_FRAC=0.08        # spec 6.4: passerby catchment, polygon dilation fraction
EDGE_REENTRY_SECONDS=2          # spec 8.2: merge a fresh track into a just-dropped one within this window (0 disables)
EDGE_REENTRY_DISTANCE=0.06      # spec 8.2: and within this normalized distance
EDGE_FROZEN_FRAME_SECONDS=30    # spec 8.1: identical frames for this long means the source is frozen, treat as offline
EDGE_REF_DIR=                   # spec 8.1: dir for per-camera drift reference hashes (default <sqlite dir>/refframes; empty here uses that)
EDGE_RECALIBRATION_CHECK_SECONDS=3600  # spec 8.1: how often to hash the live view against the reference
EDGE_DRIFT_HAMMING_THRESHOLD=12 # spec 8.1: bits (of 64) the hash may differ before it counts as drift
EDGE_DRIFT_SAMPLES=2            # spec 8.1: consecutive over-threshold checks before flagging needs_recalibration
EDGE_BUCKET_SECONDS=900         # spec 6.5: rollup bucket width in stream-time seconds

# --- Cloud (M2: schema + attribution) ---
DATABASE_URL=postgresql+psycopg://whaletale:whaletale@localhost:5432/whaletale
WHALETALE_TEST_DATABASE_URL=     # optional; if unset, tests start a throwaway container
WHALETALE_BASELINE_WEEKS=4       # spec 6.5: trailing weeks for the "against itself" comparison
WHALETALE_ANOMALY_SIGMA=2        # spec 6.5: SD from baseline before a bucket is flagged
WHALETALE_ADMIN_TOKEN=           # spec 9: internal fleet admin API; unset disables it

# --- Cloud API (from M5) ---
REDIS_URL=redis://localhost:6379/0
API_SECRET_KEY=
SENTRY_DSN=

# --- Auth (from M6) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Stripe (from M9) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=                 # per-camera recurring price (spec 12)
WHALETALE_BILLING_GRACE_DAYS=7   # spec 8.5: grace before the console goes read-only
WHALETALE_BILLING_EXPORT_DAYS=30 # spec 8.5: export window after a cancel

# --- Web (from M6) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
